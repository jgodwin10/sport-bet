# Copy to .env and edit. Never commit .env. All keys stay server-side.
ENVIRONMENT=development
LOG_LEVEL=INFO
POSTGRES_PASSWORD=footy
# Used when running outside Docker (compose overrides these two):
DATABASE_URL=postgresql+psycopg://footy:footy@localhost:5432/footy
REDIS_URL=redis://localhost:6379/0
# celery = background worker (Docker); inline = run jobs in an API thread (local dev without worker)
TASK_MODE=inline
CORS_ORIGINS=["http://localhost:5173"]

# Auth: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me
JWT_TTL_MINUTES=120
# Optional: create an admin on startup (or use `python -m app.cli create-admin you@example.com`)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
RATE_LIMIT_PER_MINUTE=120

# ---- Data providers ----
# football-data.co.uk: free CSVs (results, stats, xG from 2026/27, pre-match + closing odds). No key.
FOOTBALL_DATA_CO_UK_ENABLED=true
# football-data.org: authoritative kickoff times/status. Free tier key: https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_API_KEY=
# The Odds API: live multi-bookmaker odds. Free tier 500 credits/month: https://the-odds-api.com
THE_ODDS_API_KEY=
THE_ODDS_API_REGIONS=uk,eu
# API-Football: injuries/suspensions + official lineups. Free plan 100 req/day: https://www.api-football.com
API_FOOTBALL_KEY=

# ---- Gemini AI analysis (optional) ----
# One or more Google AI Studio keys (https://aistudio.google.com/apikey), separated by commas.
# Requests rotate across keys; a key that is rate-limited, out of daily quota or rejected is
# skipped and retried later, so extra keys raise the effective limit.
GEMINI_API_KEYS=
# Models tried in order; a model the API doesn't know falls through to the next.
GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash
# Let Gemini search the web for injuries/lineups/news (Google Search grounding)
GEMINI_SEARCH_GROUNDING=true
# Scheduled analysis for fixtures kicking off within N hours (0 = only on demand), capped per run
GEMINI_AUTO_HOURS=48
GEMINI_AUTO_MAX_PER_RUN=10
GEMINI_REFRESH_HOURS=12

# Competitions to track (codes in backend/app/ingestion/competitions.py)
COMPETITIONS=["ENG-1","ENG-2","GER-1","ESP-1","ITA-1","FRA-1"]
HISTORY_SEASONS=4

# Model / schedule
DC_HALF_LIFE_DAYS=240
DC_RIDGE=2.0
FIXTURES_REFRESH_MINUTES=360
ODDS_REFRESH_MINUTES=60
LINEUP_CHECK_MINUTES=15
LINEUP_WINDOW_MINUTES=90
